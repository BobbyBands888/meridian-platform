# Copy to .env.local for local development, and add the same names in Vercel:
# Project > Settings > Environment Variables.

# Supabase: Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret key (sb_secret_...). Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Resend (Phase 3+)
RESEND_API_KEY=

# Cloudflare Turnstile (Phase 5)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where approval and lead-copy emails go
ADMIN_EMAIL=
